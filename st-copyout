#!/bin/sh
# Using external pipe with st, give a wmenu prompt of recent commands,
# allowing the user to copy the output of one.
# By Jaywalker and Luke
tmpfile=$(mktemp /tmp/st-cmd-output.XXXXXX)
trap 'rm "$tmpfile"' 0 1 15
sed -n "w $tmpfile"
sed -i 's/\x0//g' "$tmpfile"
ps1="$(grep "\S" "$tmpfile" | tail -n 1 | sed 's/^\s*//' | cut -d' ' -f1)"
if ! command -v wmenu >/dev/null 2>&1; then
	printf "st-copyout: wmenu is required to choose command output\\n" >&2
	exit 127
fi
chosen="$(grep -F "$ps1" "$tmpfile" | sed '$ d' | tac | wmenu -p "Copy which command's output?" -i -l 10 | sed 's/[^^]/[&]/g; s/\^/\\^/g')"
[ -n "$chosen" ] || exit 0
eps1="$(echo "$ps1" | sed 's/[^^]/[&]/g; s/\^/\\^/g')"
awk "/^$chosen$/{p=1;print;next} p&&/$eps1/{p=0};p" "$tmpfile" | st-clipboard
